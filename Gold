//@version=5
strategy("Gold Killer: Pure Price Action Breakout", overlay=true, initial_capital=1000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// --- 1. INPUTS ---
ny_timezone = input.string("America/New_York", title="Timezone") 

// TIME SETTINGS
kz_setup_time = input.session("2000-2030", title="1. Range Formation (Setup Phase)")
trading_session = input.session("2030-0000", title="2. Trading Window (Breakout)") 

// BREAKOUT FILTERS (PURE PRICE ACTION)
// Dapat dako ang lawas (e.g. 0.5x ATR) para "Impulse"
atr_mult = input.float(0.5, title="Min Candle Body (x ATR)") 

// RISK MANAGEMENT
rr_ratio = input.float(2.0, title="Risk:Reward Ratio")
sl_padding = input.float(0.5, title="SL Padding (Points)") 

// VISUALS
col_setup_bg = input.color(color.new(color.gray, 85), title="Setup Box Color")
col_range_line = input.color(color.new(color.blue, 0), title="Breakout Levels")
col_profit = input.color(color.new(color.teal, 60), title="Profit Box")
col_loss = input.color(color.new(color.maroon, 60), title="Risk Box")
col_entry = input.color(color.gray, title="Entry Line")

// --- 2. TIME LOGIC ---
t_setup = time(timeframe.period, kz_setup_time + ":1234567", ny_timezone)
inSetup = not na(t_setup)

t_trade = time(timeframe.period, trading_session + ":1234567", ny_timezone)
inTrading = not na(t_trade)

// --- 3. VARIABLES ---
var float setupHigh = na
var float setupLow = na
var int setupStartIdx = na

var bool highBroken = false
var bool lowBroken = false
var int tradesToday = 0

// Visual Objects
var box b_setup = na
var line l_high = na
var line l_low = na
var box activeTPBox = na
var box activeSLBox = na
var line activeEntryLine = na

// Indicators
current_atr = ta.atr(14) 

// --- 4. RESET LOGIC ---
if inSetup and not inSetup[1]
    tradesToday := 0
    highBroken := false
    lowBroken := false
    setupHigh := high
    setupLow := low
    setupStartIdx := bar_index
    b_setup := na
    l_high := na
    l_low := na
    activeTPBox := na
    activeSLBox := na
    activeEntryLine := na

// --- 5. CAPTURE RANGE ---
if inSetup
    setupHigh := math.max(setupHigh, high)
    setupLow := math.min(setupLow, low)

// --- 6. DRAW SETUP VISUALS ---
if not inSetup and inSetup[1]
    b_setup := box.new(setupStartIdx, setupHigh, bar_index, setupLow, bgcolor=col_setup_bg, border_style=line.style_dashed, border_color=color.gray)
    l_high := line.new(bar_index, setupHigh, bar_index, setupHigh, color=col_range_line, width=2)
    l_low := line.new(bar_index, setupLow, bar_index, setupLow, color=col_range_line, width=2)

// EXTEND LINES
if inTrading
    if not highBroken and not na(l_high)
        line.set_x2(l_high, bar_index)
    if not lowBroken and not na(l_low)
        line.set_x2(l_low, bar_index)

// --- 7. EXECUTION: PURE BREAKOUT ---
if inTrading and tradesToday == 0 and not na(setupHigh)
    
    // Filter: Body Size only (No Volume)
    float bodySize = math.abs(close - open)
    bool isBigBody = bodySize > (current_atr * atr_mult)
    
    // --- BULLISH BREAKOUT ---
    if close > setupHigh and not highBroken
        if isBigBody
            highBroken := true
            
            float entryPrice = close
            float stopPrice = low - sl_padding
            float risk = entryPrice - stopPrice
            float targetPrice = entryPrice + (risk * rr_ratio)
            
            strategy.entry("Long Break", strategy.long)
            strategy.exit("Exit Long", "Long Break", stop=stopPrice, limit=targetPrice)
            tradesToday := 1
            
            // Visuals
            activeTPBox := box.new(bar_index, entryPrice, bar_index + 3, targetPrice, bgcolor=col_profit, border_width=0)
            activeSLBox := box.new(bar_index, entryPrice, bar_index + 3, stopPrice, bgcolor=col_loss, border_width=0)
            activeEntryLine := line.new(bar_index, entryPrice, bar_index + 3, entryPrice, color=col_entry)
            line.set_style(l_high, line.style_dotted)

    // --- BEARISH BREAKDOWN ---
    if close < setupLow and not lowBroken
        if isBigBody
            lowBroken := true
            
            float entryPrice = close
            float stopPrice = high + sl_padding
            float risk = stopPrice - entryPrice
            float targetPrice = entryPrice - (risk * rr_ratio)
            
            strategy.entry("Short Break", strategy.short)
            strategy.exit("Exit Short", "Short Break", stop=stopPrice, limit=targetPrice)
            tradesToday := 1
            
            // Visuals
            activeTPBox := box.new(bar_index, entryPrice, bar_index + 3, targetPrice, bgcolor=col_profit, border_width=0)
            activeSLBox := box.new(bar_index, stopPrice, bar_index + 3, entryPrice, bgcolor=col_loss, border_width=0)
            activeEntryLine := line.new(bar_index, entryPrice, bar_index + 3, entryPrice, color=col_entry)
            line.set_style(l_low, line.style_dotted)

// --- 8. VISUALS EXTENSION ---
if strategy.position_size != 0
    if not na(activeTPBox)
        box.set_right(activeTPBox, bar_index + 2)
    if not na(activeSLBox)
        box.set_right(activeSLBox, bar_index + 2)
    if not na(activeEntryLine)
        line.set_x2(activeEntryLine, bar_index + 2)

// VERIFICATION LABELS
if barstate.isconfirmed
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        if strategy.closedtrades > 0
            float pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
            bool isWin = pnl > 0
            string resText = isWin ? "TP Hit 💰" : "SL Hit ❌"
            color resColor = isWin ? color.green : color.red
            if not inTrading and inTrading[1]
                resText := resText + "\n(Time Cut)"
            label.new(bar_index, high, resText, color=resColor, textcolor=color.white, style=label.style_label_down, size=size.small)

// FORCE CLOSE
if not inTrading and inTrading[1]
    strategy.close_all(comment="Time Close")
    activeTPBox := na
    activeSLBox := na
    activeEntryLine := na
